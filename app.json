{
  "expo": {
    "name": "GuineaPal",
    "slug": "guineapal",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*",
      "assets/fonts/*"
    ],
    "ios": {
      "bundleIdentifier": "com.tasha.guineapal",
      "buildNumber": "1.0.1",
      "supportsTablet": true,
      "jsEngine": "hermes",
      "config": {
      "googleMobileAdsAppId": "ca-app-pub-1405426793776119~3196291007"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tasha.guineapal",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "splash": {
        "image": "./assets/icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BILLING",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "allowBackup": true,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMobileAdsAppId": "ca-app-pub-1405426793776119~1660161441"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://github.com/expo/router"
        }
      ],
      "expo-splash-screen",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/SpaceMono.ttf"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GuineaPal to access your photos to upload pet pictures",
          "cameraPermission": "Allow GuineaPal to use your camera to take pet photos"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow GuineaPal to save photos to your gallery",
          "savePhotosPermission": "Allow GuineaPal to save photos to your gallery",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#5D4037",
          "androidCollapsedTitle": "GuineaPal Alerts"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow GuineaPal to access your microphone."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "androidClientId": "1405426793776119-1660161441.apps.googleusercontent.com"
        }
      ],
     
      [
  "expo-build-properties",
  {
    "android": {
      "compileSdkVersion": 34,
      "targetSdkVersion": 34,
      "buildToolsVersion": "34.0.0",
      "kotlinVersion": "1.9.25",
      "extraMavenRepos": [
        "https://maven.google.com"
      ],
      "gradleCommand": ":app:assembleDebug"
    }
    
  }
],
      [
  "react-native-google-mobile-ads",
  {
    "androidAppId": "ca-app-pub-1405426793776119~1660161441",
    "iosAppId": "ca-app-pub-1405426793776119~3196291007"
  }
]

    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 30000,
      "checkAutomatically": "ON_LOAD"
    },
    "owner": "tashaingle",
    "extra": {
      "eas": {
        "projectId": "d149b9fe-85ba-43b2-9577-b176594a069a"
      }
    },
    "description": "A comprehensive guinea pig care management app that helps you track your pet's health, schedule, and daily care needs."
  }
}
